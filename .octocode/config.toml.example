# Octocode project-level configuration
# This file should be checked into version control.

[model]
default = "deepseek-v4-flash"
heavy = "deepseek-v4-pro"
thinking_mode = "auto"          # off | on | auto
reasoning_effort = "max"
allow_legacy_model_alias = false

[execution]
default_lane = "chat_non_thinking"
plan_lane = "plan_thinking"
fim_lane = "fim_non_thinking"
json_output_enabled = true

[search]
engine = "local"
use_deepseek_rerank = true
max_results = 50
max_context_tokens = 12000
include_git_diff = true
include_sessions = true

[cache]
stable_prefix_enabled = true
warn_on_low_cache_hit = true

[policy]
auto_approve_safe_read = true
auto_mode = false
network_access = false
command_timeout_seconds = 120
require_approval_for_write = true
require_approval_for_command = true
autonomy_level = "off"          # off | low | medium | high
block_protected_paths = true
normalize_unicode_commands = true

[paths]
protected = [
  "~/.ssh/**",
  "~/.aws/**",
  "~/.gnupg/**",
  "**/.env",
  "**/.env.*",
  "**/credentials*",
  "/etc/**"
]

[ui]
language = "zh-CN"
theme = "auto"                  # auto | light | dark | high-contrast
motion = "subtle"               # subtle | off
renderer = "auto"               # auto | classic | fullscreen
show_reasoning_summary = true
show_raw_reasoning = false
show_cache_hud = true

[provider]
default = "deepseek"

# First-class OpenAI-compatible Chinese provider presets:
# default = "qwen"   # DASHSCOPE_API_KEY / BAILIAN_API_KEY
# default = "kimi"   # MOONSHOT_API_KEY
# default = "zhipu"  # ZAI_API_KEY
#
# [provider.qwen]
# base_url = "https://dashscope.aliyuncs.com/compatible-mode/v1"
# pro_model = "qwen3-coder-plus"
# flash_model = "qwen3-coder-flash"
#
# [provider.kimi]
# base_url = "https://api.moonshot.cn/v1"
# pro_model = "kimi-k2.6"
# flash_model = "kimi-k2.5"
#
# [provider.zhipu]
# base_url = "https://open.bigmodel.cn/api/paas/v4"
# pro_model = "glm-5.1"
# flash_model = "glm-4.7-flashx"

[router]
enabled = true
conservative = true
use_model_classifier = true
simple_threshold = 40
confidence_threshold = 0.75
shadow_mode = false

[subagent]
enabled = true
swarm_enabled = true
max_parallel = 4
auto_decompose = true
write_requires_approval = true
command_requires_approval = true
default_model = "deepseek-v4-flash"
allow_custom_agents = false

[mcp]
enabled = false

[hooks]
pre_tool = []
post_tool = []
stop = []

[telemetry]
enabled = false
